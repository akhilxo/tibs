# ============================================================
# TIBS — Pretty URL Rewrite Rules
# Requires Apache with mod_rewrite enabled (Laravel Herd default)
# ============================================================

RewriteEngine On

# --- Redirect .php extension to clean URL (301) ---
# e.g. /about.php → /about
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Redirect /index to / (canonical home) ---
RewriteRule ^index$ / [R=301,L]

# --- Serve .php file for clean URLs ---
# e.g. /about → about.php (internally)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# --- Remove trailing slashes (except root) ---
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]
